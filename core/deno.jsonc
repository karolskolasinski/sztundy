{
  "imports": {
    "hono": "jsr:@hono/hono@^4.13.16",
    "postgres": "npm:postgres@^4.1.1"
  },
  "tasks": {
    // --allow-sys=homedir: the npm "postgres" package calls node:os.homedir(), which Deno gates behind the sys permission
    "start": "deno run --env-file --allow-sys=homedir --allow-env --allow-net main.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "options": {
      "lineWidth": 100
    }
  }
}
